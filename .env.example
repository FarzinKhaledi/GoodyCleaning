# Copy to .env.local for local development. Keep real values out of Git.
# Blank entries below require your own credentials/configuration.

# Dedicated GoodyCleaning Postgres connection; required for ALL enquiry submissions.
# Apply the base schema first, then `npm run db:migrate-quotes` before this workflow.
DATABASE_URL=

# Local development URLs. In production, set BOTH to https://goodycleaning.co.uk.
# goodycleaning.com and www variants should redirect to the primary .co.uk domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Enquiry mode saves requests to /admin; admins set all quote prices manually.
# Configure the database and Gmail below. No public automatic tariff is shown.
# Keep false unless an instant-booking tariff and all backend services are approved.
# This public build-time flag must be true to show the full instant-booking form.
NEXT_PUBLIC_INSTANT_BOOKING_ENABLED=false

# Server-only Gmail OAuth credentials for enquiries, admin quotes and payment emails.
# Use the verified support Google Workspace connection with Gmail send permission.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# All branded messages send from support@goodyvan.com.
# Connect that account directly, or verify its send-as alias on the connected account.
GMAIL_SENDER=support@goodyvan.com
# Optional fallback when GMAIL_SENDER is empty; must also be support@goodyvan.com.
GMAIL_USER=

# Auth.js: generate a private value with `openssl rand -base64 32`.
AUTH_SECRET=

# Revolut Merchant API: use sandbox credentials while developing; never test real charges.
# Production requires the intended live account key and API URL below.
REVOLUT_SECRET_KEY=
# Signing secret for the dedicated Cleaning endpoint in the same environment:
# https://goodycleaning.co.uk/api/webhooks/revolut
# Keep GoodyVan's existing webhook and secret separate.
REVOLUT_WEBHOOK_SECRET=
# Set explicitly; sandbox: https://sandbox-merchant.revolut.com/api
# Production: https://merchant.revolut.com/api
REVOLUT_API_URL=
# Optional explicit sandbox or production; must match the API URL/key environment.
# Generic sk_ Merchant keys do not establish sandbox mode.
REVOLUT_ENVIRONMENT=
# Before sharing live Merchant credentials with GoodyVan, verify its webhook
# ignores Cleaning orders and checks its own stored order ownership. See README.

# Optional legacy Resend adapter settings. Current enquiries, quotes and payment
# confirmations all use verified Gmail above and do not require these variables.
RESEND_API_KEY=
# Use a sender on your verified domain, e.g. GoodyCleaning <hello@goodycleaning.co.uk>.
# The onboarding@resend.dev fallback is for development/testing only.
MAIL_FROM=
# Legacy adapter destination; current Cleaning notifications use support@goodyvan.com.
ADMIN_EMAIL=

# Admin account creation via `npm run db:seed`.
# Use an explicit email and a unique password of at least 12 characters.
# Seeding leaves existing admin passwords unchanged and inserts no sample reviews.
ADMIN_EMAIL_LOGIN=
ADMIN_PASSWORD=
