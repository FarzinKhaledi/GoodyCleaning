# Copy to .env.local for local development. Keep real values out of Git.
# Blank entries below require your own credentials/configuration.

# Database: a dedicated GoodyCleaning Postgres database connection string.
DATABASE_URL=

# Local development URLs. In production, set BOTH to https://goodycleaning.co.uk.
# goodycleaning.com and www variants should redirect to the primary .co.uk domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Initial launch uses enquiry mode: email quote drafts and phone links need no backend.
# Keep false until prices are approved and payment/database/email services are ready.
# This public build-time flag must be true to show the full instant-booking form.
NEXT_PUBLIC_INSTANT_BOOKING_ENABLED=false

# Auth.js: generate a private value with `openssl rand -base64 32`.
AUTH_SECRET=

# Revolut Merchant API: use sandbox credentials while developing.
# Production requires the correct live account key and production API URL.
REVOLUT_SECRET_KEY=
# Signing secret for the webhook registered in the same Revolut environment.
REVOLUT_WEBHOOK_SECRET=
# Optional explicit API base; examples:
# Sandbox: https://sandbox-merchant.revolut.com/api/1.0
# Production: https://merchant.revolut.com/api/1.0
# If omitted, the application chooses the environment from the secret key.
# REVOLUT_API_URL=

# Resend: required in production. The app fails email delivery if its key is absent.
RESEND_API_KEY=
# Use a sender on your verified domain, e.g. GoodyCleaning <hello@goodycleaning.co.uk>.
# The onboarding@resend.dev fallback is for development/testing only.
MAIL_FROM=
# Mailbox that receives quote requests and payment alerts.
ADMIN_EMAIL=

# Admin account creation via `npm run db:seed`.
# Use an explicit email and a unique password of at least 12 characters.
# Seeding leaves existing admin passwords unchanged and inserts no sample reviews.
ADMIN_EMAIL_LOGIN=
ADMIN_PASSWORD=
